<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenFreshr Sparkle appcast.

  Served by GitHub Pages at https://trsdn.github.io/OpenFreshr/appcast.xml
  (Settings → Pages → "Deploy from a branch" → main / /docs). This URL is the
  SUFeedURL baked into the app's Info.plist.

  This feed is INTENTIONALLY EMPTY until the first notarised, EdDSA-signed
  release exists. It must only ever advertise correctly signed builds
  (PLAN.md, Phase 7 acceptance criteria). Do NOT hand-write an <item> pointing
  at an unsigned or unnotarised artifact.

  Release process (see docs/release/README.md for the full flow):
    1. The broker builds, signs, notarises and staples OpenFreshr-vX.Y.Z-macOS-arm64.zip.
    2. Generate the EdDSA signature for that exact artifact with Sparkle's tool:
         sign_update OpenFreshr-vX.Y.Z-macOS-arm64.zip
       (this uses the PRIVATE key stored only in the broker's secrets — never here).
    3. Add an <item> below using the template in the comment, filling in:
         - sparkle:shortVersionString  → X.Y.Z (matches CFBundleShortVersionString)
         - sparkle:version             → the CFBundleVersion of that build
         - enclosure url               → the GitHub release download URL
         - enclosure length            → the artifact's byte size
         - sparkle:edSignature         → the base64 signature from sign_update
    4. Commit the updated appcast; Pages publishes it; clients see the update.

  <item> template (keep this in sync with the shipping build):

  <item>
    <title>OpenFreshr 1.0.0</title>
    <link>https://github.com/trsdn/OpenFreshr/releases/tag/v1.0.0</link>
    <sparkle:version>1</sparkle:version>
    <sparkle:shortVersionString>1.0.0</sparkle:shortVersionString>
    <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
    <pubDate>Mon, 01 Sep 2025 10:00:00 +0000</pubDate>
    <description><![CDATA[ Siehe CHANGELOG.md. ]]></description>
    <enclosure
      url="https://github.com/trsdn/OpenFreshr/releases/download/v1.0.0/OpenFreshr-v1.0.0-macOS-arm64.zip"
      length="FILL_IN_BYTE_SIZE"
      type="application/octet-stream"
      sparkle:edSignature="FILL_IN_BASE64_ED_SIGNATURE" />
  </item>
-->
<rss version="2.0"
     xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>OpenFreshr</title>
    <link>https://trsdn.github.io/OpenFreshr/appcast.xml</link>
    <description>Updates für OpenFreshr.</description>
    <language>de</language>
    <!-- No published, signed release yet. Add <item> entries here per the
         process documented above. -->
  </channel>
</rss>
