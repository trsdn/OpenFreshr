# Swift Package Manager
.build/
.swiftpm/

# Package.resolved is deliberately tracked. This is an application, not a
# library, so builds have to be reproducible: the notarization broker pins the
# build to a committed lockfile (`dependency_lock` in its profile), and an
# unpinned dependency graph would let a release differ from what was reviewed.

# XcodeGen output is regenerated from project.yml; the checked-in project is only
# refreshed deliberately for broker builds.
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
*.hmap
*.dSYM.zip
*.dSYM

# Swift
*.o

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp

# Worktrees created for agent sessions live inside the checkout.
.worktrees/
