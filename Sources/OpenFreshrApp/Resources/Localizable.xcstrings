    },
    "The tool reported success, but the renewed scan does not confirm it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Werkzeug meldete Erfolg, der erneute Scan bestätigt ihn aber nicht."
          }
        }
      }
    },
    "The update source did not answer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Update-Quelle hat nicht geantwortet"
          }
        }
      }
    },
    "This app cannot be adopted and updated automatically — please update via the vendor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App kann nicht automatisch übernommen und aktualisiert werden — bitte über den Hersteller aktualisieren."
          }
        }
      }
    },
    "This app cannot be adopted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
