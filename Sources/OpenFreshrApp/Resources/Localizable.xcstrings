    },
    "This app has its own updater, but you chose the AI agent instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App hat einen eigenen Updater, aber du hast stattdessen den KI-Agenten gewählt."
          }
        }
      }
    },
    "This app is already present. A reinstall is normally not necessary." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist bereits vorhanden. Eine erneute Installation ist normalerweise nicht nötig."
          }
        }
