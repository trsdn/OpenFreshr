    "%@: Homebrew reported success, but the renewed scan does not confirm it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Homebrew meldete Erfolg, der erneute Scan bestätigt ihn aber nicht."
